{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frame-studio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "observability": {"enabled": true},
  "containers": [{"class_name":"StudioAPI","image":"../../services/api/Dockerfile","image_build_context":"../..","instance_type":"basic","max_instances":1}],
  "durable_objects": {"bindings":[{"name":"STUDIO_API","class_name":"StudioAPI"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["StudioAPI"]}],
  "vars": {"WEB_ORIGIN":"https://render-video.pages.dev","R2_BUCKET":"frame-studio-exports"}
}
