POSTGRES_PASSWORD=replace_with_a_random_password
STUDIO_OWNER_TOKEN=replace_with_at_least_32_random_characters
WEB_ORIGIN=http://127.0.0.1:3000
# For production, PostgreSQL must be durable and use TLS.
DATABASE_URL=postgresql://user:password@host/studio?sslmode=require
WORKSPACE_BUDGET_MICRO_USD=50000000
RENDER_TARIFF_MICRO_USD=20000
# Cloudflare R2 private bucket for production exports.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=frame-studio-exports
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
